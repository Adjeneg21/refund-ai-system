# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real API keys.

# --- LLM provider ---
# Default setup uses Groq, which is FREE (no credit card required) and
# OpenAI-API-compatible, so no code changes are needed.
#   1. Go to https://console.groq.com/keys
#   2. Sign in and click "Create API Key"
#   3. Paste it below
LLM_API_KEY=gsk_your-groq-key-here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

DATABASE_URL=file:./data/refund.db


ADMIN_TOKEN=replace-with-a-long-random-string

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

RATE_LIMIT_PER_MIN=20

# --- App ---
PORT=4000
NODE_ENV=development
