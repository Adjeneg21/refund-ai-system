# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real API keys.

# --- LLM provider ---
# Default setup uses Groq, which is FREE (no credit card required) and
# OpenAI-API-compatible, so no code changes are needed.
#   1. Go to https://console.groq.com/keys
#   2. Sign in and click "Create API Key"
#   3. Paste it below
LLM_API_KEY=gsk_your-groq-key-here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# To use OpenAI instead, comment out LLM_BASE_URL above and set:
# LLM_API_KEY=sk-your-openai-key-here
# LLM_MODEL=gpt-4o-mini

# --- Database ---
# Default: local SQLite file, zero setup required.
DATABASE_URL=file:./data/refund.db

# --- Admin dashboard ---
# Shared-secret gate for the admin surface (not real per-user auth — see
# README's Assumptions & Trade-offs section). Typed into the dashboard's
# sign-in screen.
# Optional for local runs: if left unset, the backend generates a random token
# on first start, saves it to backend/data/.admin-token and prints it in the
# backend logs. REQUIRED in production (NODE_ENV=production). To choose your
# own, use a long random value, e.g.: openssl rand -hex 24
# ADMIN_TOKEN=

# --- CORS ---
# Comma-separated browser origins allowed to call the API. Add your deployed
# frontend URL here.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Abuse protection ---
# Max refund submissions per client IP per minute.
RATE_LIMIT_PER_MIN=20

# --- App ---
PORT=4000
NODE_ENV=development
